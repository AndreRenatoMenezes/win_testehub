# https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.md]
# dois espacos no fim da linha = quebra de linha no Markdown
trim_trailing_whitespace = false
